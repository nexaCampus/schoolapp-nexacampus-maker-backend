# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install ca-certificates and tzdata
RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Compile pure Go binary with stripped debug symbols (-s -w) for minimal footprint
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -extldflags '-static'" \
    -trimpath \
    -o /app/bin/tenant-runtime ./cmd/tenant-runtime

# Final ultra-minimal runtime stage (< 20MB)
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 appuser \
    && mkdir -p /data && chown -R appuser:appuser /data

WORKDIR /app
COPY --from=builder /app/bin/tenant-runtime /app/tenant-runtime

USER appuser

ENV PORT=8080
ENV ENV=production
ENV DB_PATH=/data/tenant.db

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/app/tenant-runtime"]
